# Copy this file to `.env` or `.env.<name>` (example: `.env.my-dev`) and fill values.
#
# IMPORTANT:
# - Do NOT commit real tokens.
# - The CLI detects `.env` / `.env.<name>` in the directory you run it from.

# Logging format for the Rust CLI.
# - pretty: human-friendly logs (default)
# - json: machine-friendly structured logs (good for CI/log aggregation)
MDS_LOG_FORMAT=pretty

# Shopify credentials (required)
MDS_CLI_SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
MDS_CLI_SHOPIFY_ACCESS_TOKEN=shpat_your_access_token_here

